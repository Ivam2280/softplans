{
  "name": "softplans",
  "version": "1.0.0",
  "description": "A calm, multilingual task planner with local-first storage.",
  "author": "Ivan Tovstukha",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm test",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
